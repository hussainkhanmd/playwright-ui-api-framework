# =============================================================================
# Environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# All variables are validated by src/common/config/env.schema.ts at startup;
# an invalid or missing required value fails the run immediately.
# In CI, inject these as secrets / environment variables instead of a file.
# =============================================================================

# Which environment profile to resolve base URLs from: dev | staging | prod
TEST_ENV=dev

# Optional hard overrides. When set, these win over the profile in environments.ts.
# UI_BASE_URL=https://www.saucedemo.com
# API_BASE_URL=http://127.0.0.1:3001
# THE_INTERNET_BASE_URL=https://the-internet.herokuapp.com

# Local json-server mock backend
MOCK_SERVER_PORT=3001
MOCK_SERVER_AUTO_START=true

# Application credentials (SauceDemo demo users are public and safe to commit as an example)
UI_USERNAME=standard_user
UI_PASSWORD=secret_sauce

# Test run behaviour
CI=false
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
RETRIES=0
WORKERS=

# Structured logging: fatal | error | warn | info | debug | trace | silent
# `info` logs every HTTP request/response; drop to `warn` for quiet runs.
LOG_LEVEL=warn

# -----------------------------------------------------------------------------
# Experimental AI-augmented layer (src/ai/*). OFF by default. Never required.
# -----------------------------------------------------------------------------
AI_FEATURES_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# CI notifications (optional)
# -----------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
